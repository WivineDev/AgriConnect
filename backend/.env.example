PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=agriconnect
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
# Required only when running `npm run seed:admin`.
ADMIN_FULL_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
# Comma-separated frontend origins; leave empty to use local development defaults.
FRONTEND_ORIGINS=
